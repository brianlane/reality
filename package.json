{
  "name": "reality",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "hono": "4.13.14",
    "@hono/node-server": "1.19.14",
    "effect": "^3.20.0",
    "lodash": "^4.17.21",
    "ws": "8.22.0",
    "@babel/core": "7.29.7",
    "uuid": "11.1.1",
    "@opentelemetry/core": "2.8.0",
    "@opentelemetry/instrumentation-knex": "0.65.0",
    "@opentelemetry/instrumentation-mongoose": "0.67.0",
    "@opentelemetry/instrumentation-mysql": "0.67.0",
    "@opentelemetry/instrumentation-mysql2": "0.67.0",
    "@opentelemetry/instrumentation-pg": "0.73.0",
    "@opentelemetry/instrumentation-tedious": "0.40.0",
    "minimatch@10.2.4": {
      "brace-expansion": "5.0.12"
    },
    "browserslist": "4.29.4",
    "fast-uri": "3.1.9",
    "source-map-js": "1.2.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "format": "prettier --write . --ignore-path .gitignore",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "env -u NO_COLOR FORCE_COLOR=0 playwright test",
    "db:dev": "npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "db:seed": "npx prisma db seed",
    "db:full": "concurrently \"npm run db:dev\" \"npm run db:studio\"",
    "dev:all": "concurrently \"npm run db:dev\" \"npm run db:studio\" \"npm run dev\" --names \"DB,STUDIO,NEXT\" -c \"blue,magenta,green\"",
    "db:reset": "npx prisma migrate reset && npm run seed:questions",
    "seed:questions": "npx tsx scripts/seed-questions.ts",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.20",
    "@floating-ui/dom": "^1.7.6",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^10.42.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "html-minifier-terser": "^7.2.0",
    "next": "^16.4.3",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.9.3",
    "sanitize-html": "^2.18.1",
    "stripe": "^20.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^25",
    "@types/pg": "8.11.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "@vitest/ui": "^4.0.18",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lightningcss": "^1.31.1",
    "lint-staged": "^16.3.2",
    "prettier": "^3.2.5",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
